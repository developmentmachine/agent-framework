{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-framework.dev/spec/events/stream-event.schema.json",
  "title": "StreamEvent",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "phase", "runId"],
      "properties": {
        "type": { "const": "lifecycle" },
        "phase": { "enum": ["start", "end", "error"] },
        "runId": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "delta"],
      "properties": {
        "type": { "const": "assistant" },
        "delta": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "callId", "name", "status"],
      "properties": {
        "type": { "const": "tool" },
        "callId": { "type": "string" },
        "name": { "type": "string" },
        "status": { "enum": ["start", "end", "error"] },
        "output": {}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "tokens"],
      "properties": {
        "type": { "const": "usage" },
        "tokens": {
          "type": "object",
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          },
          "required": ["input", "output", "total"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
